# Process environment > external private config > this repository .env.
# External config defaults to $XDG_CONFIG_HOME/freeqify/freeqify.env or
# ~/.config/freeqify/freeqify.env; override with FREEQIFY_CONFIG_FILE.
# Phase 3 remains loopback-only until a later deployment phase.
HOST=127.0.0.1
PORT=3000
# Must begin and end with /, e.g. /freeqify/. Same value for build and runtime.
BASE_PATH=/
# Keep persistent data separate from the source checkout and original music.
# Default: $XDG_DATA_HOME/freeqify or ~/.local/share/freeqify (private 0700).
# Must be outside the source checkout, web root, and original music.
# DATA_DIR=/your/private/freeqify-data
WEB_DIST_DIR=./apps/web/dist
DEV_ALLOWED_HOSTS=localhost

# Server-only service account. Never prefix secrets with VITE_.
# URL must use loopback. Alternate ports and upstream prefixes allowed.
NAVIDROME_URL=http://127.0.0.1:4533/
NAVIDROME_USERNAME=
# Prefer an absolute path to an owner-only (0600) file outside the repository.
NAVIDROME_PASSWORD_FILE=
# Alternatively set NAVIDROME_PASSWORD in the process/private config (not Git).
# NAVIDROME_PASSWORD=
NAVIDROME_TIMEOUT_MS=8000

# Native launcher settings. Replace these with your own absolute paths.
# MUSIC_DIR is required for navidrome:start and is NEVER a browser API parameter.
MUSIC_DIR=
# Required before native engine launch: private mount/witness proof, captured only
# while the selected drive is independently confirmed mounted. See Linux guide.
MUSIC_READINESS_FILE=
# Fresh installation: true. Optional migration review: false until verification.
NAVIDROME_SCAN_ON_STARTUP=true
# Scheduled/watcher scans are disabled; use a readiness-checked restart to rescan.
# Default persistent data: $XDG_DATA_HOME/freeqify-navidrome or
# ~/.local/share/freeqify-navidrome. Never put it in the checkout or music folder.
# NAVIDROME_DATA_DIR=
# Optional config file, outside the checkout; safe launcher env settings win.
# NAVIDROME_CONFIG_FILE=
# Default executable: navidrome on PATH. Installer defaults to ~/.local/bin/navidrome.
# NAVIDROME_BINARY=
# Default read-only isolation is Bubblewrap. Only use "external" if the host
# already enforces read-only music via a mount, ACL, or container configuration.
# NAVIDROME_READ_ONLY_ISOLATION=external

# Account/session security. HTTPS production defaults to Secure cookies.
# Local HTTP development defaults to false; a local compiled HTTP smoke test
# must explicitly use false. Do not disable Secure cookies for HTTPS deployment.
# AUTH_SECURE_COOKIES=true
# Maximum 720 hours / 43,200 idle minutes; absolute expiry always applies.
SESSION_HOURS=720
SESSION_IDLE_MINUTES=43200

# Phase 3 streaming uses NAVIDROME_TIMEOUT_MS for response headers, not song length.
# MP3 fallback uses the existing Navidrome/FFmpeg profile and external engine cache.
# Progressive buffering is automatic in temporary browser memory (current + next).
# No extra credentials, VITE_* secrets, or playback port are needed.
# Temporary queue recovery stores only per-account references/settings in the browser.
# Explicit MP3 downloads use separate account-scoped device storage; see DOWNLOAD_FFMPEG_PATH.

# Phase 4 personal collections/history share private DATA_DIR via migrations 3–4.
# No extra database, service, port, browser secret, or music write access is needed.

# Phase 5B local security. No public/proxy deployment is enabled.
# Optional private local corpus: SHA-1 password fingerprints, one per line,
# optionally HASH:count. Owner-only, no symlinks; never raw passwords.
# AUTH_BLOCKLIST_FILE=/your/private/password-fingerprints.txt
# Stream admission is fail-fast (no waiting queue). HEAD counts too.
MAX_STREAMS=16
MAX_STREAMS_PER_USER=8
MAX_TRANSCODES=2
MAX_CATALOG_REQUESTS=8
MAX_CATALOG_PER_USER=4
CATALOG_TIMEOUT_MS=30000
REQUESTS_PER_MINUTE=600
# Logical personal metadata/queue budgets, not music file limits.
PERSONAL_BYTES_PER_USER=268435456
PERSONAL_BYTES_TOTAL=2147483648
METADATA_BYTES_PER_TRACK=16384
# SQLite main-file ceiling; WAL/temp/cache require additional disk headroom.
DATABASE_MAX_BYTES=4294967296
MIN_DATA_FREE_BYTES=268435456

# Phase 5C prepared contract; local remains default. Does not authorize exposure.
DEPLOYMENT_MODE=local
# Proxy mode is production-only, with Secure cookies and one overwriting TLS hop.
# X-Forwarded-Host may be absent or exactly match PUBLIC_ORIGIN's host.
# X-Forwarded-For must contain one client IP; forwarded chains are rejected.
# PUBLIC_ORIGIN=https://music.example.test
# TRUSTED_PROXY_PEER=127.0.0.1

# Optional automatic lookup and administrator mobile/desktop cover search.
# Entered artist/album names are sent server-side to MusicBrainz/Cover Art Archive.
# MUSICBRAINZ_CONTACT is an identifiable contact, not an API credential.
# MUSICBRAINZ_CONTACT=mailto:you@example.test
# Existing scanner report + downloaded/ directory, read-only; defaults to
# $XDG_DATA_HOME/freeqify-artwork-review (or ~/.local/share/freeqify-artwork-review).
# ARTWORK_REVIEW_DIR=/path/to/freeqify-artwork-review

# Optional Tools → Playlist Import album handoff (no Spotify credentials).
# Playlist acquisition queues persist in DATA_DIR. Seek all runs in the server
# background while its authorizing admin session remains valid; no extra service
# or background worker configuration is needed.
# Keep Lidarr on loopback; its API key is read only by the server from a 0600 file.
# LIDARR_URL=http://127.0.0.1:your-lidarr-port/
# LIDARR_API_KEY_FILE=/private/path/lidarr-api-key
# Optional: an EXISTING Lidarr root folder ID for adding new artists. Its existing
# default quality/metadata profiles and tags are reused; no preferences are edited.
# Without this, add the artist in Lidarr first, then review its albums in Tools.
# LIDARR_ROOT_FOLDER_ID=1

# Optional existing engine administrator, used ONLY for starting scans.
# Keep normal catalog/streaming credentials restricted; both fields required together.
NAVIDROME_SCAN_USERNAME=
NAVIDROME_SCAN_PASSWORD_FILE=

# PWA installation uses PUBLIC_ORIGIN/BASE_PATH above; no separate install host,
# native wrapper or additional credentials are required.

# For HTTP 403 diagnosis, use server request-denied reason categories; keep
# PUBLIC_ORIGIN exact and the existing single-hop proxy contract. Do not disable
# Secure cookies or CSRF to compensate for stale browser tabs.

# Explicit offline downloads are MP3 files stored only on the user's device.
# Non-MP3 sources convert through FFmpeg stdin/stdout; no converted files are
# stored on this server and Navidrome is requested in raw mode (no new transcode cache).
# Bare name uses PATH; relative paths resolve against the repository root.
DOWNLOAD_FFMPEG_PATH=ffmpeg

# Audiobooks use the existing NAVIDROME_* connection and DATA_DIR account database.
# Register files/Audiobooks as a separate read-only Navidrome library, and grant
# NAVIDROME_USERNAME access. Freeqify selects its exact name (default Audiobooks).
AUDIOBOOKS_LIBRARY_NAME=Audiobooks
# Optional Open Library cover matching/search; an identifiable contact, not a key.
# AUDIOBOOKS_COVER_CONTACT=mailto:you@example.test
# Optional stable Navidrome library ID overrides name selection; NOT a file path.
# AUDIOBOOKS_MUSIC_FOLDER_ID=3
# Music automatically uses the remaining accessible library, excluding Audiobooks.
# If multiple music libraries remain, select one explicitly (never the books ID).
# NAVIDROME_MUSIC_FOLDER_ID=2
# Missing/ambiguous/inaccessible libraries never fall back to all music.
# Original audio streams with browser byte ranges; files must be browser-decodable.
# Chapter markers and private reading state are stored in Freeqify, not source tags.

# Optional embedded audiobook chapter reader (read-only, bounded range requests).
# Defaults to ffprobe from PATH; relative executable paths resolve from repo root.
AUDIOBOOKS_FFPROBE_PATH=ffprobe
# Optional spoken-heading previews and synchronized audiobook transcripts.
# Opening audiobook Mode → Lyrics recognizes bounded passages and privately caches
# text in DATA_DIR. No audio upload or saved audio copy. Requires a local Python environment
# with openai-whisper and a local model file; Freeqify never downloads a model.
# Audio stays local, and names change only after the listener reviews/saves them.
# Set BOTH to enable. Relative paths resolve against the repository root.
# AUDIOBOOKS_SPEECH_PYTHON=tools/speech/bin/python
# AUDIOBOOKS_SPEECH_MODEL=models/small.en.pt
# Automatic audiobook transcript recognition is separately opt-in. Leave false on
# shared hosts unless their resource policy and measured capacity permit it.
# Spoken-heading previews remain available through the speech settings above.
AUDIOBOOKS_TRANSCRIPTS_ENABLED=false
# Optional audio reader for short speech samples (default ffmpeg from PATH).
# AUDIOBOOKS_FFMPEG_PATH=ffmpeg

# Optional free lyrics in Now Playing (LRCLIB; no account or API key).
# Sends song title, artist, album and duration only when the listener opens Lyrics.
# Playback remains independent. No audio is uploaded; disable to keep lookups local.
LYRICS_ENABLED=false
