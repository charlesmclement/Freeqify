# PREPARATION ONLY. Substitute reviewed exact hostname, certificate/key, confirmed
# free HTTPS port and backend port. Never include this in a live server unreviewed.
# Dedicated host only; do not add Navidrome locations. No prefix stripping.
server {
    listen 127.0.0.1:8443 ssl;
    server_name music.example.test;
    ssl_certificate /REVIEW/private/cert.pem;
    ssl_certificate_key /REVIEW/private/key.pem;
    client_max_body_size 4m;
    # Keep protocol/Host unchanged. Return 444 for an unexpected Host.
    if ($http_host != music.example.test:8443) { return 444; }
    location / {
        proxy_pass http://127.0.0.1:REVIEW_BACKEND_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_cache off;
        proxy_no_cache 1;
        proxy_buffering off;
        proxy_request_buffering on;
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
    }
}
# Server PUBLIC_ORIGIN=https://music.example.test:8443, TRUSTED_PROXY_PEER=127.0.0.1,
# DEPLOYMENT_MODE=proxy, NODE_ENV=production, AUTH_SECURE_COOKIES=true.
# For default 443 use an exact matching Host/origin without :8443. A second proxy
# hop and caller-supplied chains are unsupported. Keep real_ip modules disabled
# unless independently reviewed; $remote_addr must mean the actual TLS client.
